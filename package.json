{
  "name": "collabhub",
  "version": "1.0.0",
  "private": true,
  "description": "Find your people. Build something great. A complete MERN collaboration platform.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"e2e/**/*.js\" \"*.{json,js,yaml,md}\" \"docs/*.md\" \".github/workflows/*.yml\"",
    "dev:vercel": "node --env-file-if-exists=.env scripts/serve-vercel-local.cjs",
    "verify": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
