MONGODB_URI=mongodb://127.0.0.1:27017/collabhub?replicaSet=rs0&directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Optional image upload integration. Set these securely on your hosting platform.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional override for Socket.IO delivery. Vercel Production defaults to
# https://collab-hub-d51v.onrender.com; local function runs default to polling.
# Use the same JWT_SECRET and MONGODB_URI on both hosts. Leave empty for polling.
REALTIME_URL=
